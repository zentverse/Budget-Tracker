# --- Python ---
__pycache__/
*.pyc

# --- Environment ---
venv/
.venv/
env/

# --- Data Handling ---
# Ignore all Excel/CSV data files to prevent leaking personal info
*.xlsx
*.csv

# --- Exceptions (Tracked Files) ---
# Allow tracking of the Master dataset
!master/*.xlsx

# --- Application Data Folders ---
# Ignore raw data uploads backup folder
data/

# --- OS Specific ---
.DS_Store
Thumbs.db
